#!/bin/sh
if command -v python >/dev/null 2>&1; then
    python_bin=python
else
    python_bin=python3
fi
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in
        *[!0]*) "$python_bin" scripts/check_repository_hygiene.py --revision "$local_oid" || exit 1 ;;
    esac
done
