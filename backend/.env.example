# Database Configuration (MySQL)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=documind_db

# Security & JWT Configuration
SECRET_KEY=super_secret_key_documind_123
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Paste your key into backend/.env, never into frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_INPUT_CHARS=8000
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_REQUEST_TIMEOUT_SECONDS=45
GEMINI_CACHE_ENABLED=true

# Optional semantic retrieval; content indexing/search does not call a model.
SEARCH_EMBEDDING_MODEL=gemini-embedding-001
SEARCH_EMBEDDING_DIMENSIONS=768
SEARCH_EMBEDDING_TIMEOUT_SECONDS=15

# T39: cleanup starts automatically with the FastAPI lifespan (run.py or uvicorn).
# First sweep runs at startup, then every interval; disable only for isolated tests.
RETENTION_CLEANUP_ENABLED=true
RETENTION_CLEANUP_INTERVAL_SECONDS=3600
RETENTION_CLEANUP_BATCH_SIZE=100
