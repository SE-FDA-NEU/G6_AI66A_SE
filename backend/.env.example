# Database Configuration (MySQL / Cloud MySQL)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=documind_db
# TLS: disabled | preferred | required | verify_ca | verify_identity
DB_SSL_MODE=preferred
DB_SSL_CA=
DB_CONNECT_TIMEOUT_SECONDS=10
DB_READ_TIMEOUT_SECONDS=30
DB_WRITE_TIMEOUT_SECONDS=30
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
# Keep false on shared/cloud databases so bootstrap never drops non-model tables.
DB_DROP_EXTRA_TABLES=false

# Persistent Document Storage & Coordinated Backups
STORAGE_DIR=data/uploads
BACKUP_DIR=data/backups

# Security & JWT Configuration
SECRET_KEY=super_secret_key_documind_123
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Paste your key into backend/.env, never into frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_INPUT_CHARS=8000
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_REQUEST_TIMEOUT_SECONDS=45
GEMINI_CACHE_ENABLED=true

# Optional semantic retrieval; content indexing/search does not call a model.
SEARCH_EMBEDDING_MODEL=gemini-embedding-001
SEARCH_EMBEDDING_DIMENSIONS=768
SEARCH_EMBEDDING_TIMEOUT_SECONDS=15

# T39: cleanup starts automatically with the FastAPI lifespan (run.py or uvicorn).
# First sweep runs at startup, then every interval; disable only for isolated tests.
RETENTION_CLEANUP_ENABLED=true
RETENTION_CLEANUP_INTERVAL_SECONDS=3600
RETENTION_CLEANUP_BATCH_SIZE=100
ANALYSIS_PROVIDER=gemini
GROQ_FALLBACK_ENABLED=false
