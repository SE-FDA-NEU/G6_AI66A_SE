    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "postcss": "^8.5.31",
    "pptx-preview": "1.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0"
  },
